{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  org.clojure/core.async {:mvn/version "1.9.865"}

  ;; Result types, rescue/guard, lifecycle protocol
  io.github.hive-agi/hive-dsl {:mvn/version "0.5.31"}

  ;; Logging
  com.taoensso/timbre {:mvn/version "6.8.0"}
  metosin/malli {:mvn/version "0.20.1"}
  org.typedclojure/typed.clj.runtime {:mvn/version "1.4.0"}}

 :aliases
 {:dev
  {:extra-paths ["test"]
   :extra-deps
   {io.github.hive-agi/hive-dsl {:mvn/version "0.5.31"}
    io.github.hive-agi/hive-test {:mvn/version "0.4.9"}
    lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.hive-agi/hive-test {:mvn/version "0.4.9"}
    lambdaisland/kaocha {:mvn/version "1.91.1392"}
    io.github.hive-agi/hive-schemas {:mvn/version "0.1.37"}}
   :main-opts ["-m" "kaocha.runner"]}

  ;; Clojars publishing (see ../hive-build). version = the repo's VERSION file.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.22"}}
   :ns-default hive-build.api}
  :typed {:extra-paths ["dev-typed"]
          :extra-deps {org.typedclojure/typed.clj.checker {:mvn/version "1.4.0"}}}
  :bench {:extra-paths ["dev"]
            :jvm-opts ["-Xmx2g" "-XX:+UseG1GC"]
            :extra-deps
            {manifold/manifold {:mvn/version "0.5.0"}
             com.climate/claypoole {:mvn/version "1.1.4"}
             funcool/promesa {:mvn/version "11.0.678"}
             org.clojure/core.async {:mvn/version "1.9.865"}
             org.clojure/data.json {:mvn/version "2.5.2"}
             nrepl/nrepl {:mvn/version "1.3.1"}}}}}
